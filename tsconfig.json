{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "components/PortfolioChatbot.BROWSER-VOICE-STABLE.tsx",
    "node_modules",
    "components/PortfolioChatbot.old.tsx",
    "components/**/*.backup.tsx",
    "components/**/*.before-*.tsx",
    "components/**/*.stable-v2.tsx",
    "components/**/*.voice-*.tsx"
  ]
}
